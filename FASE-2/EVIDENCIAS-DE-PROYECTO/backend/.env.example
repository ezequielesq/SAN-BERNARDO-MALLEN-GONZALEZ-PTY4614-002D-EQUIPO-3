# Variables de entorno de Smart RDP (copia este archivo como .env y completa los valores).
# El archivo .env no se sube al repositorio.

# Contrasena del usuario postgres: la usa el backend y el docker-compose.yml.
SMARTRDP_DB_PASSWORD=

# Secreto con el que se firman los tokens JWT, en Base64 y de al menos 32 bytes.
# Generar uno:   openssl rand -base64 48
SMARTRDP_JWT_SECRET=

# Administrador inicial (se crea al primer arranque solo si ambas estan definidas).
SMARTRDP_ADMIN_EMAIL=
SMARTRDP_ADMIN_PASSWORD=
