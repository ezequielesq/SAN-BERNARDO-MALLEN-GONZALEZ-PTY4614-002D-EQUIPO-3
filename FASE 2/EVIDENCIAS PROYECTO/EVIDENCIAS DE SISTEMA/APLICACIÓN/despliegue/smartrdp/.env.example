# Variables del stack "smartrdp". Se cargan en Portainer (Environment variables); este archivo solo documenta los nombres.
# Genera los secretos en la Raspberry:
#   contraseña de la base:   openssl rand -base64 24     (la misma que en el stack "db")
#   secreto JWT:             openssl rand -base64 48

SMARTRDP_DB_NAME=smartrdp
SMARTRDP_DB_USER=smartrdp_app
SMARTRDP_DB_PASSWORD=

# Secreto con el que se firman los tokens: Base64, al menos 32 bytes. No reutilices uno que haya estado en el repositorio.
SMARTRDP_JWT_SECRET=

# Administrador inicial: se crea solo en el primer arranque si ambas están definidas. Elige tú la contraseña.
SMARTRDP_ADMIN_EMAIL=
SMARTRDP_ADMIN_PASSWORD=

# Dirección pública de la aplicación (la del túnel de Cloudflare), sin barra final.
APP_URL=https://bodega.ejemplo.cl

# Puerto local de la Raspberry (solo 127.0.0.1) al que apunta la ruta del túnel si cloudflared corre en el host.
FRONTEND_PORT=8081
