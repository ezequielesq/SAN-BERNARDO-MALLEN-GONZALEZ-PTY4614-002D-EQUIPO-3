# Variables del stack "db". Se cargan en Portainer (Environment variables); este archivo solo documenta los nombres.
# Genera la contraseña en la Raspberry:   openssl rand -base64 24

# Contraseña del superusuario "postgres": solo para administrar; ninguna aplicación la usa.
# Las bases y usuarios de cada aplicación se crean después con nueva-base.sh (ver despliegue/README.md).
PG_SUPERUSER_PASSWORD=

# Carpeta de la Raspberry donde se guardan los respaldos (debe existir).
BACKUP_DIR=/srv/backups/postgres
